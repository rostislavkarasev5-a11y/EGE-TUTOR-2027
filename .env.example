# Пример файла настроек. Скопируйте его в .env и заполните ТОЛЬКО на своём компьютере.
# Файл .env закрыт в .gitignore и никогда не должен попадать в GitHub.

# ИИ (Phase 6, ADR-0017): Yandex AI Studio. Без этих строк программа работает без ИИ.
# На сервере их записывает deploy/set-ai-key.sh — вручную вписывать не нужно.
# EGE_AI_PROVIDER=yandex
# EGE_AI_MONTHLY_BUDGET_RUB=300
EGE_YANDEX_FOLDER_ID=
EGE_YANDEX_API_KEY=

# Необязательно: другая папка с конфигурацией (по умолчанию ./config).
# EGE_TUTOR_CONFIG_DIR=
